// Functional diagram: Ochsner heat pump <-> eBUS <-> ebusd <-> FHEM  (fixed layout)
// render: neato -n2 -Tpng -Gdpi=110 fhem_ebusd_schema.dot -o fhem_ebusd_schema.png
digraph G {
  graph [fontname="Helvetica", splines=line, bgcolor="white", outputorder=nodesfirst];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f4f4f4", color="#666666", width=2.6, height=0.7, fixedsize=false];
  edge  [fontname="Helvetica", fontsize=9, color="#666666"];

  // ---- frames (drawn first) ----
  f_wp    [pos="430,1022", width=4.3, height=3.45, shape=box, style="rounded,dashed", fillcolor="none", label="", color="#888888"];
  f_wp_l  [pos="430,912", label="Heat pump", shape=plaintext, style="", fontsize=11];
  f_pi    [pos="587,210", width=15.1, height=13.75, shape=box, style="rounded", fillcolor="none", label="", color="#999999"];
  f_pi_l  [pos="587,684", label="Raspberry Pi  (ebusd and FHEM on the same host)", shape=plaintext, style="", fontsize=11];
  f_eb    [pos="425,505", width=9.9, height=4.6, shape=box, style="rounded,dashed", fillcolor="none", label="", color="#888888"];
  f_eb_l  [pos="425,348", label="ebusd 26.1", shape=plaintext, style="", fontsize=11];
  f_mq    [pos="660,195", width=4.9, height=1.35, shape=box, style="rounded,dashed", fillcolor="none", label="", color="#888888"];
  f_mq_l  [pos="660,230", label="MQTT broker (any: FHEM MQTT2_SERVER, Mosquitto, ...)", shape=plaintext, style="", fontsize=10];
  f_fh    [pos="587,-69", width=14.4, height=5.45, shape=box, style="rounded,dashed", fillcolor="none", label="", color="#888888"];
  f_fh_l  [pos="587,-252", label="FHEM", shape=plaintext, style="", fontsize=11];

  // ---- heat pump ----
  panel  [pos="430,1110", label="Control panel\neBUS master 01", fillcolor="#fff3d6"];
  ote    [pos="430,975",  label="OTE3 controller\neBUS master 10 / slave 15\nTEM protocol (read 0621, write 0623)", fillcolor="#fff3d6", width=3.3];
  adapter[pos="430,800",  label="eBUS Adapter Shield C6 (Stick)\nUSB serial, enhanced protocol", fillcolor="#e8eefc", width=3.0];
  wlan   [pos="900,800",  label="WLAN\nadapter status + web UI only", shape=ellipse, style="dashed", fillcolor="#ffffff", width=2.6];

  // ---- ebusd ----
  cfgw   [pos="200,630", label="ochsner_write/  (write)\n7 messages: whitelist, value lists\naccess level 'write'", fillcolor="#e3f5e3", width=2.9];
  cfgr   [pos="660,630", label="ochsner/  (read)\n56 messages, polling", width=2.4];
  acl    [pos="200,505", label="ACCESS CONTROL  (--aclfile)\nlevel 'write' only after auth\nuser 'mqtt' has no level", shape=octagon, fillcolor="#fde2e0", color="#d43b2b", penwidth=2, width=2.9];
  mqttc  [pos="660,505", label="MQTT client\n--mqttclientid=ebusWP", width=2.4];
  tcp    [pos="200,380", label="TCP 8888 (--localhost)\nauth / write / read -f", fillcolor="#e3f5e3", width=2.4];

  // ---- broker + FHEM ----
  broker [pos="660,180", label="here: FHEM MQTT2_SERVER\nport 1883", fillcolor="#e8eefc", width=2.6];
  util   [pos="200,40",  label="99_ebusWPUtils.pm  (only write path)\nvalidation: whitelist, range, step, enum\nlock, daily limit, queue >= 10 s, watchdog\nauth - write - 12 s - read back", fillcolor="#e3f5e3", width=3.3];
  dev    [pos="660,40",  label="MQTT2_DEVICE ebusWP\nreadingList / userReadings\nsetList (7 write commands)", fillcolor="#e8eefc", width=2.8];
  status [pos="1000,85", label="MQTT2_DEVICE (adapter)\nuptime, signal, connection", fillcolor="#ffffff", width=2.5];
  use    [pos="1000,-10",label="Consumers\nInfluxDB / Grafana, DOIF", width=2.5];
  user   [pos="460,-330", label="set Heizung_<circuit> <command> | override on/off   (FHEMWEB, DOIF, at)", shape=note, fillcolor="#ffffff", width=5.2, height=0.4];

  // ---- 98_EBUSFUNC function blocks ----
  f_fb    [pos="575,-150", width=13.0, height=1.2, shape=box, style="rounded,dashed", fillcolor="none", label="", color="#1f9d55"];
  f_fb_l  [pos="575,-112", label="98_EBUSFUNC.pm - function blocks: readingMap (mirror), setMap (checked commands), overrideList (Sparbetrieb, Eigenverbrauch_Vorrang)", shape=plaintext, style="", fontsize=10];
  fb1     [pos="215,-158", label="Heizung_HKR1\nEBUSFUNC", fillcolor="#e3f5e3", width=1.9, height=0.55];
  fb2     [pos="445,-158", label="Heizung_HKR2\nEBUSFUNC", fillcolor="#e3f5e3", width=1.9, height=0.55];
  fb3     [pos="675,-158", label="Heizung_WW\nEBUSFUNC", fillcolor="#e3f5e3", width=1.9, height=0.55];
  fb4     [pos="905,-158", label="Heizung_WP\nEBUSFUNC", fillcolor="#e3f5e3", width=1.9, height=0.55];

  note   [pos="587,-470", shape=note, fillcolor="#fffbe6", color="#b59b2b", fontsize=10, width=11.5, label=
"Security concept\l\
- Operating data never travel via WLAN: adapter -> ebusd via USB, ebusd -> broker via localhost (same host).\l\
  Note: the broker is open to the home network (other devices use it), so clients there can read the ebusd/... topics.\l\
- Via WLAN only the adapter's own status (MQTT) and its password-protected web UI.\l\
- Writing only through 99_ebusWPUtils (TCP with authentication): validation, queue with >= 10 s spacing, read-back and\l\
  logging ensure timing and data integrity. MQTT /set cannot guarantee this and is blocked by the access control.\l\
- 98_EBUSFUNC function blocks never access the bus: every command is passed on as set ebusWP ... (same checks).\l"];
  legend [pos="587,-560", shape=plaintext, style="", fontsize=10, label="blue = operating data (read)     green = write path     red = blocked     blue+green = both directions     grey dotted = adapter status via WLAN"];

  // ---- edges ----
  panel -> ote    [dir=both, label="  eBUS"];
  ote -> adapter  [dir=both, penwidth=2, label="  eBUS (2 wires)"];
  adapter -> cfgr [dir=both, penwidth=2, label="  USB (ens:/dev/serial/by-id/...)"];
  cfgr -> mqttc   [color="#2b6cd4", label="  poll results"];
  mqttc -> broker [color="#2b6cd4", label="  localhost: ebusd/ochsner/<message>"];
  broker -> dev   [color="#2b6cd4"];
  dev -> use      [color="#2b6cd4"];

  adapter -> wlan [style=dotted, arrowhead=none];
  wlan -> broker  [style=dotted, label="adapter status via MQTT  "];
  broker -> status [style=dotted];

  user -> fb2     [color="#1f9d55"];
  dev -> fb1      [dir=both, color="#2b6cd4:#1f9d55"];
  dev -> fb2      [dir=both, color="#2b6cd4:#1f9d55"];
  dev -> fb3      [dir=both, color="#2b6cd4:#1f9d55", label="  readingMap (read) / setMap: set ebusWP <cmd> <value> (write)"];
  dev -> fb4      [dir=both, color="#2b6cd4:#1f9d55"];
  dev -> util     [dir=both, color="#1f9d55", label="{ebusWP_Set($NAME,$EVENT)}\nSchreib_Status / Schreib_Letzter"];
  util -> tcp     [dir=both, color="#1f9d55", label="  auth fhem <secret>\n  write -c ochsner ... / read -f\n  (answers, read-back)"];
  tcp -> acl      [color="#1f9d55", label="  authenticated: allowed"];
  acl -> cfgw     [color="#1f9d55"];
  cfgw -> adapter [color="#1f9d55", label="QQ 10 0623 06 <ID> <value>  "];

  mqttc -> acl    [color="#d43b2b", style=dashed, penwidth=1.6, arrowhead=tee, label=".../set via MQTT\nREJECTED"];
}
